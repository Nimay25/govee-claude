{
  "manifest_version": 3,
  "name": "Claude Lamp (web)",
  "version": "1.0",
  "description": "Tells the Claude Lamp menu bar + Govee lamp when a claude.ai chat is working or done.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["https://claude.ai/*"], "js": ["content.js"], "run_at": "document_idle" }]
}
